# Optional: set a password to protect the UI (leave empty for no auth)
KB_PASSWORD=

# Optional: domain for the app
DOMAIN=localhost

# Optional: override the shared data directory.
# Defaults to ./data for source installs, or a managed app-data path in Electron.
# CABINET_DATA_DIR=

# Optional: release manifest URL for update checks.
# CABINET_RELEASE_MANIFEST_URL=https://github.com/hilash/cabinet/releases/latest/download/cabinet-release.json

# Optional: override runtime ports and origins when embedding Cabinet in Electron.
# CABINET_APP_PORT=3000
# CABINET_DAEMON_PORT=3001
# CABINET_APP_ORIGIN=http://127.0.0.1:3000
# CABINET_PUBLIC_DAEMON_ORIGIN=ws://127.0.0.1:3001

# ============================================
# RESOLUTION ROUND API KEYS (REQUIRED)
# ============================================

# Anthropic Claude API (for agent research in Resolution Round)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Tavily Search API (for web search in Resolution Round)
# Get from: https://tavily.com/
TAVILY_API_KEY=

# Optional: Model selection (cost vs quality tradeoff)
# Latest models (2025):
# GAP_EXTRACTION_MODEL=claude-haiku-4-5        # 67% cheaper (default)
# SIMPLE_RESEARCH_MODEL=claude-haiku-4-5       # 67% cheaper (default)
# COMPLEX_RESEARCH_MODEL=claude-sonnet-4-6     # Latest Sonnet (default)
# COMPLEX_RESEARCH_MODEL=claude-opus-4-6       # Most intelligent (67% more expensive)

# ============================================
# META DESK INTEGRATION API KEYS
# ============================================

# xAI Grok API (for web search and observation collection)
# Get from: https://console.x.ai/
# Grok has built-in web_search tool (searches internet + browses pages)
# Preferred over standard Twitter API (no rate limits, broader web access)
XAI_API_KEY=

# Legacy Twitter/X API (alternative to xAI, not recommended)
# Only needed if NOT using xAI Grok API above
# Get from: https://developer.twitter.com/
# X_API_KEY=
# X_API_SECRET=
# X_BEARER_TOKEN=

# Apify (for web scraping: Twitter, Xiaohongshu, TikTok)
# Get from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# GMGN.ai API (for Solana meme coin tracking and analytics)
# Install skills: npx skills add GMGNAI/gmgn-skills
# Get from: https://gmgn.ai/
GMGN_API_KEY=
GMGN_PRIVATE_KEY=

# DEXScreener API (for Solana token launch tracking)
# Free tier doesn't require key. Pro tier:
# DEXSCREENER_API_KEY=

# Birdeye API (optional alternative to DEXScreener for token analytics)
# Get from: https://birdeye.so/
# BIRDEYE_API_KEY=

# Telegram Bot (for subscriber delivery)
# Get from: @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# OpenClaw Pipeline Settings (for data ingestion)
# Path to Cabinet data directory (for writing observations)
OPENCLAW_CABINET_DATA_DIR=

# Optional: Email delivery (deferred for MVP)
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=

# Optional: Notion sync (for publishing briefs to Notion)
# NOTION_API_KEY=

# Optional: Slack notifications (for agent alerts)
# SLACK_WEBHOOK_URL=
